# Web and API URLs (web app defaults to the local FlowNexa web dev server).
WEB_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:4000/api/v1

# Use a dedicated local/test account and a disposable test organization.
TEST_EMAIL=
TEST_PASSWORD=
TEST_ORGANIZATION_ID=
TEST_WORKSPACE_ID=

# Optional: DB read-only coverage reuses web-app/.env DATABASE_URL when unset here.
# For write-through API/UI checks, use a disposable QA database and opt in explicitly.
DATABASE_URL=
DB_ENVIRONMENT=qa
DB_MUTATION_TESTS=false

# Browser capture settings
PW_BROWSER=chromium
PW_HEADLESS=true
PW_WORKERS=2
PW_START_WEB_SERVER=false
