# Web configuration
NEXT_PUBLIC_APP_NAME=FlowNexa
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# API — replace these with long random values before running outside local development
PORT=4000
WEB_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=FlowNexa <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false
POSTGRES_PASSWORD=local-dev-only-change-me
DATABASE_URL=postgresql://flownexa:local-dev-only-change-me@localhost:5432/flownexa?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret

# Optional AI assistant; keep the key on the API server only
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
